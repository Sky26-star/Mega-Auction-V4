# MEGA AUCTION V1 â€” ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env.local and fill in your Supabase project credentials.

# Public Supabase Project URL (e.g. https://xyz.supabase.co or http://127.0.0.1:54321 for local)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anonymous API Key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Public Base Application URL (used for redirects and server-side origin resolution)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# SERVER-ONLY SECRETS â€” DO NOT EXPOSE TO CLIENT
# Supabase Service Role Key (Used for server-side REST broadcasts and admin RPCs)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database Direct Connection String (Used for Supabase CLI migrations)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# AUCTION WORKER & TICK CONFIGURATION (SERVER-ONLY)
# AUCTION_TICK_SECRET must be at least 32 characters without whitespace.
# It authenticates background worker tick requests against /api/auction/tick.
AUCTION_TICK_SECRET=replace-with-a-random-32-character-secret-key-here
# AUCTION_TICK_URL targets the /api/auction/tick route (HTTPS in production, loopback HTTP in dev)
AUCTION_TICK_URL=http://localhost:3000/api/auction/tick
